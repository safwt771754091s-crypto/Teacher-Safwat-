APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# --- PostgreSQL / Supabase (production) ---
# The platform uses Laravel Sanctum for auth and Supabase PostgreSQL for storage.
# Set DB_CONNECTION=pgsql and one of the two options below.
#
# Option A (recommended, single variable): paste the Supabase "Session pooler"
# connection string. The password is embedded, so never commit it.
#   DB_URL=postgresql://postgres.<project_ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   DB_SSLMODE=require
#
# Option B (discrete variables):
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project_ref>
# DB_PASSWORD=
# DB_SSLMODE=require
#
# Non-secret Supabase coordinates (safe to keep in the repo):
SUPABASE_PROJECT_REF=jsrpfsybgeplciiqjzqr
SUPABASE_URL=https://jsrpfsybgeplciiqjzqr.supabase.co
SUPABASE_REGION=ap-south-1
SUPABASE_POOLER_HOST=aws-0-ap-south-1.pooler.supabase.com
# Publishable (client-safe) key, exposed to browsers via GET /api/v1/config.
SUPABASE_ANON_KEY=sb_publishable_Youxpe69HUlKEmI0OPW0YQ_co8-1jJJ
#
# Textbook storage: "public" (local disk, default) or "supabase" (Supabase
# Storage via the S3 protocol — books live in the cloud and each device pulls
# only what it needs). Fill the S3 keys when using the supabase disk:
TEXTBOOK_DISK=public
SUPABASE_S3_BUCKET=textbooks
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Public object base for the storage bucket (optional; derived from the project
# ref by default). Used to build direct CDN links for stored book pages.
# SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
